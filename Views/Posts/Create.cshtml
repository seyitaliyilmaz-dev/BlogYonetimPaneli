@* Yeni blog yazısı oluşturmak için kullanılan form. *@
@model BlogYonetimPaneli.Models.Post

@{
    ViewData["Title"] = "Yeni Yazı";
}

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Title" class="control-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        @* Kategori artık açılır listeden seçilmiyor, serbestçe yazılıyor.
           autocomplete="off" ile tarayıcının önceki girişleri öneri olarak
           göstermesi engelleniyor. Aynı isim yazılırsa mevcut kategori
           kullanılır, farklıysa yeni kategori otomatik oluşturulur. *@
        <label for="categoryName" class="control-label">Kategori</label>
        <input type="text" id="categoryName" name="categoryName" class="form-control"
               autocomplete="off" placeholder="Örn: Siyaset, Teknoloji, Spor"
               value="@ViewData["CategoryName"]" />
        @if (ViewData["CategoryError"] != null)
        {
            <span class="text-danger">@ViewData["CategoryError"]</span>
        }
    </div>

    <div class="form-group">
        <label asp-for="Content" class="control-label">İçerik (Markdown desteklenir)</label>
        <textarea asp-for="Content" class="form-control" rows="12"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <div class="form-check">
        <input asp-for="IsPublished" class="form-check-input" />
        <label asp-for="IsPublished" class="form-check-label">Yayınla</label>
    </div>

    <div class="form-group mt-2">
        <input type="submit" value="Kaydet" class="btn btn-primary" />
    </div>
</form>

<a asp-action="Index">Listeye Dön</a>
