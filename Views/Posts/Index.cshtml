@* Tüm blog yazılarını, kategorileriyle ve yayın durumlarıyla birlikte listeler. *@
@model IEnumerable<BlogYonetimPaneli.Models.Post>

@{
    ViewData["Title"] = "Blog Yazıları";
}

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Yazı</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Başlık</th>
            <th>Kategori</th>
            <th>Durum</th>
            <th>Oluşturulma Tarihi</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Title</td>
            @* item.Category, PostsController'da Include(p => p.Category) ile yüklendiği için burada doludur. *@
            <td>@item.Category?.Name</td>
            <td>
                @* IsPublished durumuna göre farklı bir "damga" rozeti gösterilir. *@
                @if (item.IsPublished)
                {
                    <span class="stamp stamp--live">Yayında</span>
                }
                else
                {
                    <span class="stamp stamp--draft">Taslak</span>
                }
            </td>
            <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detay</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Sil</a>
            </td>
        </tr>
}
    </tbody>
</table>
