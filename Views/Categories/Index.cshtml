@* Bu view, veritabanındaki tüm kategorileri tablo halinde listeler. *@
@model IEnumerable<BlogYonetimPaneli.Models.Category>

@{
    ViewData["Title"] = "Kategoriler";
}

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Yeni Kategori</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Açıklama</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Detay</a>
                @if (User.IsInRole("Admin"))
                {
                    <text> | <a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a> | <a asp-action="Delete" asp-route-id="@item.Id">Sil</a></text>
                }
            </td>
        </tr>
}
    </tbody>
</table>
