@* Silme işlemi öncesi kullanıcıdan onay almak için gösterilen sayfa. *@
@model BlogYonetimPaneli.Models.Category

@{
    ViewData["Title"] = "Kategori Sil";
}

<h3>Bu kategoriyi silmek istediğine emin misin?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Ad</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Açıklama</dt>
        <dd class="col-sm-10">@Model.Description</dd>
    </dl>

    @* Bu form gönderildiğinde CategoriesController'daki DeleteConfirmed metodu çalışır. *@
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Sil" class="btn btn-danger" /> |
        <a asp-action="Index">İptal</a>
    </form>
</div>
